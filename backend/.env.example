NODE_ENV=development
PORT=3006
# Список origin'ов через запятую. Vite по умолчанию на 5173,
# но автоинкрементит до 5174+, если порт занят — поэтому указываем сразу оба.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ag_sound_calc?schema=public
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CALC_SERVICE_URL=https://dev3.constrtodo.ru:3005
# Прайс: GET /commerce/price-list/{region} и GET /commerce/regions (backend → ConstrTodo).
# Публичные /commerce/* JWT не требуют. AUTH_* нужны для /admin/commerce/regions
# (тот же логин, что в ag_co_worker):
# AUTH_EMAIL=you@example.com
# AUTH_PASSWORD=...
# Если не задан AUTH_SERVICE_URL — используется CALC_SERVICE_URL. Локально обычно http://localhost:3005.
# AUTH_SERVICE_URL=http://localhost:3005
# /api/v1/AllIsolationConstr на dev3 часто >15s — не ставьте 15000
CALC_SERVICE_TIMEOUT_MS=60000
