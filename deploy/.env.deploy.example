# ─── ag_sound_calc deploy config ─────────────────────────────────────────────
# Копируется в deploy/.env.deploy (gitignored) на локальной машине оператора.
# Читается скриптами deploy/*.sh перед ssh.

# Приватная SSH-цель frontend-машины.
DEPLOY_HOST=deploy@prodfront.mcs.local

# Публично доступный SSH jump host. Если запуск выполняется уже внутри
# приватной сети, переменную можно оставить пустой.
DEPLOY_JUMP_HOST=antares@gateway.example.com

# Абсолютный путь до checkout'а репо на сервере.
# bootstrap.sh создаёт его при первом запуске.
DEPLOY_DIR=/srv/ag_sound_calc/ag_sound_calc

# Публичный домен для smoke-тестов через отдельный gateway-01.
DEPLOY_DOMAIN=partners.constrtodo.ru

# Git-remote и ветка (или тег) на сервере. deploy-backend.sh / deploy-migrate.sh
# делают `git fetch && git checkout $DEPLOY_REV` перед перестройкой контейнеров.
DEPLOY_REMOTE=origin
DEPLOY_REV=origin/main

# Номер счётчика Яндекс.Метрики (вшивается в фронт на vite build).
# В коде уже есть дефолт 112388350; переменная нужна только для переопределения.
# VITE_YANDEX_METRIKA_ID=112388350
