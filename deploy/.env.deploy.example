# ─── ag_sound_calc deploy config ─────────────────────────────────────────────
# Копируется в deploy/.env.deploy (gitignored) на локальной машине оператора.
# Читается скриптами deploy/*.sh перед ssh.

# SSH-цель (формат: user@host или алиас из ~/.ssh/config)
DEPLOY_HOST=deploy@server.example.com

# Абсолютный путь до checkout'а репо на сервере.
# bootstrap.sh создаёт его при первом запуске.
DEPLOY_DIR=/srv/ag_sound_calc/ag_sound_calc

# Публичный домен для curl-smoke-тестов после деплоя и для подстановки в
# server_name nginx-шаблона.
DEPLOY_DOMAIN=ag.example.com

# Имя certbot-cert'а в /etc/letsencrypt/live/<cert_name>/.
# Опционально: если не задано — берётся DEPLOY_DOMAIN. Задавать только если cert
# многодоменный/wildcard и лежит в дире, отличной от DEPLOY_DOMAIN.
# Пример: wildcard *.constrtodo.ru → DEPLOY_CERT_NAME=constrtodo.ru.
# DEPLOY_CERT_NAME=constrtodo.ru

# Git-remote и ветка (или тег) на сервере. deploy-backend.sh / deploy-migrate.sh
# делают `git fetch && git checkout $DEPLOY_REV` перед перестройкой контейнеров.
DEPLOY_REMOTE=origin
DEPLOY_REV=origin/main
