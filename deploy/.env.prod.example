# ─── ag_sound_calc production env ────────────────────────────────────────────
# Положить как /srv/ag_sound_calc/ag_sound_calc/.env.prod (рядом с docker-compose.prod.yml).
# Права 0600, владелец — пользователь, от которого крутится docker compose.
# НЕ коммитить.

NODE_ENV=production
PORT=3006

# Приватный IP интерфейса prodfront, на котором Docker публикует frontend :3004.
# Не используйте 0.0.0.0: порт должен быть доступен только из локальной сети.
FRONTEND_BIND_IP=10.20.0.40

# Приватный IP gateway-01 или его CIDR. Только этому proxy доверяются X-Forwarded-*.
FRONTEND_TRUST_PROXY=10.20.0.10/32

# В проде frontend проксирует /api (same-origin), CORS де-факто не срабатывает.
# Значение нужно как страховка на случай прямого стука на API и в логах — подставьте реальный домен.
CORS_ORIGIN=https://partners.constrtodo.ru

# ─── Postgres ────────────────────────────────────────────────────────────────
# hostname = имя сервиса в docker-compose.prod.yml (postgres).
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ag_sound_calc?schema=public
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Сгенерировать так:  openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Internal ConstrTodo calc / commerce ────────────────────────────────────
# Имя должно разрешаться из backend-контейнера в приватный IP ConstrTodo.
CALC_SERVICE_URL=http://constrtodo.mcs.local:3005
# Прайс ConstrTodo: /commerce/price-list и /commerce/regions (нужен JWT).
AUTH_SERVICE_URL=http://constrtodo.mcs.local:3005
CALC_SERVICE_TIMEOUT_MS=60000

# ─── Bootstrap рутового админа ───────────────────────────────────────────────
# Нужны ТОЛЬКО для разового `make deploy-create-admin` (идемпотентно).
# После создания админа ADMIN_PASSWORD можно убрать из файла.
# ADMIN_COMPANY_ID опционален: по умолчанию дефолтная компания из миграции.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Администратор
# ADMIN_COMPANY_ID=00000000-0000-0000-0000-000000000001
