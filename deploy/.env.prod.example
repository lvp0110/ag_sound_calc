# ─── ag_sound_calc production env ────────────────────────────────────────────
# Положить как /srv/ag_sound_calc/ag_sound_calc/.env.prod (рядом с docker-compose.prod.yml).
# Права 0600, владелец — пользователь, от которого крутится docker compose.
# НЕ коммитить.

NODE_ENV=production
PORT=3006

# В проде frontend проксирует /api (same-origin), CORS де-факто не срабатывает.
# Значение нужно как страховка на случай прямого стука на API и в логах — подставьте реальный домен.
CORS_ORIGIN=https://ag.example.com

# ─── Postgres ────────────────────────────────────────────────────────────────
# hostname = имя сервиса в docker-compose.prod.yml (postgres).
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ag_sound_calc?schema=public
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Сгенерировать так:  openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── External calc service ───────────────────────────────────────────────────
CALC_SERVICE_URL=https://dev3.constrtodo.ru:3005
CALC_SERVICE_TIMEOUT_MS=60000
